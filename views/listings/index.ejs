<%- layout('layouts/boilerplate') %>
<%
const categoryIcons = {
    Mountain: "fa-mountain",
    Beach: "fa-umbrella-beach",
    Forest: "fa-tree",
    Lakefront: "fa-water",
    Camping: "fa-tent",
    City: "fa-city",
    Heritage: "fa-landmark",
    Nature: "fa-leaf",
    Safari: "fa-paw",
    Luxury: "fa-gem"
};
%>
<style>
    /* ---------------- FILTERS ---------------- */


/* ===========================
   FILTER BAR
=========================== */

.filters-wrapper{

    display:flex;

    align-items:center;

    gap:1.5rem;

    margin-bottom:1rem;

    margin-top:1rem;
}

/* Scrollable Categories */

#filters{
    flex:1;

    display:flex;
    align-items:center;

    gap:2rem;

    overflow-x:auto;
    overflow-y:hidden;

    white-space:nowrap;

    scrollbar-width:none;

    scroll-behavior:smooth;

    padding:.3rem 0;
}

#filters::-webkit-scrollbar{
    display:none;
}

/* Fixed Toggle */

.tax-toggle{

    flex-shrink:0;

    border:1.5px solid #d8d8d8;

    border-radius:16px;

    padding:.75rem 1rem;

    background:white;

    display:flex;

    align-items:center;

    min-width:max-content;

    box-shadow:0 2px 8px rgba(0,0,0,.08);
}

   

    .filter {
        text-align: center;
        opacity: 0.75;
        min-width: 82px;
        cursor: pointer;
        user-select:none;
        transition: all 0.25s ease;
        color: #222222;
    }

    .filter i {
        font-size: 1.35rem;
        margin-bottom: 0.35rem;
    }

    .filter p {
        font-size: 0.8rem;
        margin: 0;
    }

    .filter:hover {
        opacity: 1;
        color: #fe424d;
        transform: translateY(-3px);
    }

    .filter:hover i {
        color: #fe424d;
    }

    .tax-info{
    display:none;
    color:#fe424d;
    font-size:0.9rem;
    font-weight:500;
}


/* Make Bootstrap switch more visible */

.form-check-input{
    border: 1.8px solid #777;
    cursor: pointer;
}

.form-check-input:focus{
    box-shadow: none;
}

.form-check-label{
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
}
.filter.active{
    opacity:1;
    color:#fe424d;
}

.filter.active i{
    color:#fe424d;
}

.filter-link{
    text-decoration:none;
    color:inherit;
}
.filter-link:hover{
    text-decoration:none;
}

.filter-link:visited{
    color:inherit;
}

/* ===========================
   FILTER SCROLL BUTTONS
=========================== */

.scroll-btn{

    width:42px;
    height:42px;

    border:none;

    border-radius:50%;

    background:white;

    color:#444;

    box-shadow:0 4px 14px rgba(0,0,0,.12);

    display:flex;

    justify-content:center;

    align-items:center;

    cursor:pointer;

    transition:all .25s ease;

    flex-shrink:0;
}

.scroll-btn:hover{

    background:#fe424d;

    color:white;

    transform:translateY(-2px);

    box-shadow:0 8px 20px rgba(0,0,0,.18);
}

/* Hidden when unnecessary */

.scroll-btn.hidden{

    opacity:0;
    transform:scale(.85);
    pointer-events:none;
}
</style>

<body>

    <!-- Filters -->
<div class="filters-wrapper mb-3">
        
      <button
        id="scrollLeft"
        class="scroll-btn">

        <i class="fa-solid fa-chevron-left"></i>

    </button>

    <div id="filters">

    <a href="/listings" class="filter-link">
        <div class="filter <%= selectedCategory === 'All' ? 'active' : '' %>">
            <i class="fa-solid fa-border-all"></i>
            <p>All</p>
        </div>
    </a>

    <a href="/listings?category=Mountain" class="filter-link">
        <div class="filter <%= selectedCategory === 'Mountain' ? 'active' : '' %>">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
        </div>
    </a>

    <a href="/listings?category=Beach" class="filter-link">
        <div class="filter <%= selectedCategory === 'Beach' ? 'active' : '' %>">
            <i class="fa-solid fa-umbrella-beach"></i>
            <p>Beach</p>
        </div>
    </a>

    <a href="/listings?category=Forest" class="filter-link">
        <div class="filter <%= selectedCategory === 'Forest' ? 'active' : '' %>">
            <i class="fa-solid fa-tree"></i>
            <p>Forest</p>
        </div>
    </a>

    <a href="/listings?category=Lakefront" class="filter-link">
        <div class="filter <%= selectedCategory === 'Lakefront' ? 'active' : '' %>">
            <i class="fa-solid fa-water"></i>
            <p>Lakefront</p>
        </div>
    </a>

    <a href="/listings?category=Camping" class="filter-link">
        <div class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
            <i class="fa-solid fa-tent"></i>
            <p>Camping</p>
        </div>
    </a>

    <a href="/listings?category=City" class="filter-link">
        <div class="filter <%= selectedCategory === 'City' ? 'active' : '' %>">
            <i class="fa-solid fa-city"></i>
            <p>City</p>
        </div>
    </a>

    <a href="/listings?category=Heritage" class="filter-link">
        <div class="filter <%= selectedCategory === 'Heritage' ? 'active' : '' %>">
            <i class="fa-solid fa-landmark"></i>
            <p>Heritage</p>
        </div>
    </a>

    <a href="/listings?category=Nature" class="filter-link">
        <div class="filter <%= selectedCategory === 'Nature' ? 'active' : '' %>">
            <i class="fa-solid fa-leaf"></i>
            <p>Nature</p>
        </div>
    </a>

    <a href="/listings?category=Safari" class="filter-link">
        <div class="filter <%= selectedCategory === 'Safari' ? 'active' : '' %>">
            <i class="fa-solid fa-paw"></i>
            <p>Safari</p>
        </div>
    </a>

    <a href="/listings?category=Luxury" class="filter-link">
        <div class="filter <%= selectedCategory === 'Luxury' ? 'active' : '' %>">
            <i class="fa-solid fa-gem"></i>
            <p>Luxury</p>
        </div>
    </a>
    </div>
    <button
    id="scrollRight"
    class="scroll-btn">

    <i class="fa-solid fa-chevron-right"></i>

</button>
    <div class="tax-toggle">

        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                id="flexSwitchCheckDefault">
        </div>

        <label
            class="form-check-label ms-2"
            for="flexSwitchCheckDefault">
            Display Total Before Taxes
        </label>

    </div>

</div>


    <!-- Listings -->

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-5 mt-3">
            <% if(alllistings.length === 0){ %>

    <div class="col-12 text-center mt-5 offset-4">

        <i class="fa-solid fa-magnifying-glass fa-3x text-secondary mb-3"></i>

        <h4>No listings found</h4>

        <p class="text-muted">
            Try searching another location or category.
        </p>

    </div>
    <% } else { %>

        <% for(let listing of alllistings) { %>

            <a class="listing-link" href="/listings/<%= listing._id %>">

                <div class="listing-card col">

                    <img
                        src="<%= listing.image.url %>"
                        class="listing-card-img-top"
                        alt="listing_image"
                        style="height:20rem"
                    >

                    <div class="listing-card-body">

    <h5 class="listing-card-title">
         <i class="fa-solid fa-house"></i>
        <%= listing.title %>
    </h5>

    <span class="listing-category">
       
    <i class="fa-solid <%= categoryIcons[listing.category] %>"></i>
    <%= listing.category %>
    </span>

    <p class="listing-location">
        <i class="fa-solid fa-location-dot"></i>
         <span>
        <%= listing.location %>, <%= listing.country %>
            </span>
    </p>

    <p class="listing-card-text">
        <%= listing.description %>
    </p>
    <hr >

    <div class="listing-price-row">

        <div>

            <span class="listing-card-price">
                ₹ <%= listing.price.toLocaleString("en-IN") %>
            </span>

            <span class="price-night">
                / night
            </span>

        </div>

        <span class="tax-info">
            +18% GST =
            ₹ <%= Math.round(listing.price*1.18).toLocaleString("en-IN") %>
        </span>

    </div>

</div>

                </div>

            </a>

        <% } %>
     <% } %>

    </div>

</body>
<script>
const taxSwitch = document.querySelector("#flexSwitchCheckDefault");
const taxInfos = document.querySelectorAll(".tax-info");

taxSwitch.addEventListener("change", () => {

    taxInfos.forEach((taxInfo) => {

        taxInfo.style.display = taxSwitch.checked ? "inline" : "none";

    });

});


// =============================
// Category Scroll Buttons
// =============================

const filters = document.querySelector("#filters");

const leftBtn = document.querySelector("#scrollLeft");

const rightBtn = document.querySelector("#scrollRight");

function updateButtons(){

    leftBtn.classList.toggle(
        "hidden",
        filters.scrollLeft <= 5
    );

    rightBtn.classList.toggle(
        "hidden",
        filters.scrollLeft + filters.clientWidth >= filters.scrollWidth - 5
    );

}

leftBtn.addEventListener("click",()=>{

    filters.scrollBy({

        left:-300,

        behavior:"smooth"

    });

});

rightBtn.addEventListener("click",()=>{

    filters.scrollBy({

        left:300,

        behavior:"smooth"

    });

});

filters.addEventListener("scroll",updateButtons);

window.addEventListener("load",updateButtons);
</script>
